# Every environment variable this backend reads, grouped by what stops
# working without it. Copy to .env and fill in.
#
# This file previously listed 7 of the 21 variables the code actually reads,
# so a fresh setup produced a backend with no calls, no recordings, no
# conversion tracking and no address lookup — with nothing saying why.
#
# To check this file is still complete:
#   grep -rhoE "os\.environ(\.get)?[\(\[][\"'][A-Z_]+[\"']" $(git ls-files '*.py')

# ─── Required ────────────────────────────────────────────────────────────
# Read with os.environ[...] at import — the app will NOT START without them.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# JWT signing key (HS256) for access/refresh tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# TOTP secret encryption key (Fernet). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

# ─── Meta lead ingestion ─────────────────────────────────────────────────
# Without these, leads submitted on Meta never reach the CRM.

# Echoed back to Meta when it verifies the webhook subscription. Any string;
# it must match what is entered in the Meta app's webhook settings.
META_WEBHOOK_VERIFY_TOKEN=

# Signs incoming webhooks. Every payload's X-Hub-Signature-256 is checked
# against this, so a wrong value rejects every real lead.
META_APP_SECRET=

# Fetches the customer's submitted answers. Meta's webhook carries only a
# leadgen_id, never the name/phone/email — see meta_graph.fetch_lead_data.
META_PAGE_ACCESS_TOKEN=

# THE FULL URL for fetching a lead's submitted answers. Used verbatim.
#
# This is the way to point the app somewhere else — a newer Meta version, or
# a local stub. Optional: unset, it is built from META_GRAPH_API_VERSION
# below, which is what every environment does today.
#
# Setting this makes META_GRAPH_API_VERSION irrelevant for lead fetching, so
# the version has to be in the URL.
META_GRAPH_API_BASE=https://graph.facebook.com/v21.0

# Graph API version, used ONLY to build the two base URLs when they are not
# set explicitly. Defaults to v21.0. Must look like v21.0 — a malformed value
# stops the app at startup rather than 404ing on the next real lead.
#
# When neither base is set, this keeps lead fetching and the Conversions API
# on the same version automatically. Set the bases and that guarantee is
# yours to keep: the app warns at startup if the two end up on different
# versions, but does not refuse to start.
META_GRAPH_API_VERSION=v21.0

# ─── Website lead intake (0127) ──────────────────────────────────────────
# The quote form on the website reaches POST /webhooks/website through the
# website's own server, which signs every body with this secret
# (X-PolicyScanner-Signature: sha256=<hex>). The SAME value is set on the
# website's server as a secret; it must never reach a browser.
#
# UNSET REFUSES EVERY SUBMISSION with a 503, so the website shows the customer
# the phone number rather than a false thank-you. A different value per
# environment: staging's secret must not be able to sign a production lead.
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
WEBSITE_WEBHOOK_SECRET=

# ─── Meta Conversions API ────────────────────────────────────────────────
# Reports Lead / Quote Done / Sold back to Meta so its optimisation can see
# which ads produce real business.
#
# WITHOUT THE FIRST TWO, NOTHING IS SENT. services/meta_signal.py logs an
# error and leaves every signal Pending — there is no other symptom.

META_CAPI_DATASET_ID=
META_CAPI_ACCESS_TOKEN=

# READ-ONLY reporting credential, and a DIFFERENT system user from the one
# above. The sending token belongs to a system user that is not assigned to the
# dataset, so it can POST events but cannot read anything back about them —
# every reporting call returns "(#100) Missing Permission".
#
# This one is generated from the system user that IS assigned to the dataset
# (Business Settings > Users > System Users > Generate token), which is what
# lets meta_reporting.py read last_fired_time and /stats.
#
# NEVER used for sending, and the two are deliberately not merged: swapping the
# sending token for one that has never been write-tested would take live
# conversion tracking down to gain a reporting panel.
#
# Optional. Unset, the admin screen shows "Meta reporting unavailable" and
# every local figure still renders.
META_DATASET_QUALITY_TOKEN=

# Splits a DASH driver's name into first / middle / last (claude_client.py).
# DASH prints the surname first and the shape varies even inside one report —
# CHEEMA,SAJIDA and SHARMA KARAN and Otherperson Second all appear — so which
# word is the surname needs real-world knowledge, not a positional rule.
#
# OPTIONAL. Unset, comma and single-word names still split locally; an
# AMBIGUOUS name is left blank for the broker rather than guessed, because a
# wrong split is stored confidently and nobody looks at a filled box.
ANTHROPIC_API_KEY=

# THE FULL URL conversion events are POSTed to. Used verbatim; optional, and
# built from META_GRAPH_API_VERSION when unset.
#
# DELIBERATELY SEPARATE from META_GRAPH_API_BASE. That one gets pointed at a
# local stub during development, and sharing a single variable would send
# real conversion events there — which happened once, silently. Keep both on
# the same Meta version unless you specifically mean not to.
META_CAPI_BASE=https://graph.facebook.com/v21.0

# Optional. Defaults to system_generated, which is what Meta's own CRM
# integration guide specifies — leave unset unless Meta's guidance changes.
META_CAPI_ACTION_SOURCE=

# ONE DATASET (migration 0133). Every conversion — Lead, CompleteRegistration,
# Purchase — goes to META_CAPI_DATASET_ID above (Auto Insurance in production,
# PolicyScanner – Staging Test on staging). The per-dataset variables of the
# five-dataset setup (META_CAPI_DATASET_COMMON, _COMMON_FULL, _PREFERRED,
# _PREFERRED_FULL, and the older _CREAM) are no longer read.

# Where the "conversion signals failed" alert goes (migration 0113, and
# services/meta_signal_alert.py).
#
# WITHOUT THIS THERE IS NO ALERT. A Failed signal still lands on the CAPI
# dashboard, but nothing prompts anyone to open it — which is how the WhatsApp
# channel went 12 days and 77 consecutive failures unnoticed. Needs RESEND_*
# configured too; with either missing the failures are left unreported AND
# unstamped, so setting it later still surfaces them.
#
# ONE MAIL PER NEW BATCH, never a repeat of a failure already reported. A CAPI
# failure is a reporting problem rather than an operational one (the broker has
# the lead and is working it), so this goes to whoever runs the integration, not
# to brokers.
CAPI_ALERT_EMAIL=

# ─── Address lookup ──────────────────────────────────────────────────────
# Google Places. Without it the address autocomplete on the quote screen
# returns nothing.
GOOGLE_PLACES_API_KEY=

# Base for both Places calls (autocomplete and details). Optional — the
# default below is the real one. One variable, because the two calls share a
# base and differ only in path.
GOOGLE_PLACES_BASE=https://places.googleapis.com/v1

# ─── Deployment ──────────────────────────────────────────────────────────
# Allowed CORS origins, comma-separated for more than one (staging + prod).
# Defaults to the local dev servers, so it can stay unset in development.
# A wrong value here makes every request from the app fail as a CORS error.
FRONTEND_ORIGIN=

# ─── WhatsApp lead notifications (Twilio) ────────────────────────────────
# Tells a broker on their phone that a lead has just been assigned to them.
# ALL FOUR of the first variables must be set or the feature stays off: the
# drain logs "not configured" and never starts, so an environment without
# Twilio pays nothing. Nothing is ever sent to a broker who has not opted in
# (broker.whatsapp_opted_in_at, migration 0109) regardless of these values.

TWILIO_ACCOUNT_SID=
# The account's master credential. Prefer a scoped API Key where possible —
# an API key can be revoked on its own, this cannot.
TWILIO_AUTH_TOKEN=
# The Messaging Service (MG...), NOT a bare from-number: sending via the
# service means swapping the WhatsApp sender later is a change in Twilio's
# console and nothing in this codebase moves.
TWILIO_MESSAGING_SERVICE_SID=
# The APPROVED template's Content SID (HX...). WhatsApp forbids free text to
# someone who has not messaged us in 24h, and a broker never messages us, so
# every message must be this template. Changing the wording means submitting
# a new template and putting its new SID here.
TWILIO_TEMPLATE_SID=
# Absolute public HTTPS URL of our delivery-receipt endpoint, e.g.
# https://api.policyscanner.ca/webhooks/twilio/status
# It is also what Twilio's signature is validated against, so it must match
# byte for byte. Left unset, sends still work but every message stops at
# 'Submitted' and real delivery is never known.
TWILIO_STATUS_CALLBACK_URL=

# ─── WhatsApp lead notifications (Meta Cloud API) ────────────────────────
# Tells a broker on their phone that a lead has just been assigned to them.
# THE FIRST THREE must be set or the feature stays off: the drain logs "not
# configured" and never starts, so an environment without Meta pays nothing.
# Nothing is ever sent to a broker who has not opted in
# (broker.whatsapp_opted_in_at, migration 0109) regardless of these values.
#
# REPLACED TWILIO. Twilio was a reseller in front of these same Meta APIs; when
# the Twilio account was disconnected every send returned "404 (20404)" and 77
# notifications failed over eleven days without anyone noticing, because this
# feature's failures are invisible. The TWILIO_* block above is dead once
# twilio_client.py is deleted.

# System User token from Business Settings, NOT the 24-hour test token the API
# Setup page hands out — that one expires overnight and every send then fails
# 401 in a way that looks like a broken number. Needs whatsapp_business_messaging.
WHATSAPP_ACCESS_TOKEN=
# The SENDER, as Meta's numeric id rather than the phone number itself. This is
# the /{id}/messages path segment; the human-readable number appears nowhere.
WHATSAPP_PHONE_NUMBER_ID=
# A SECOND SENDER for reminders (renewals and callbacks), so a broker can mute
# that thread without losing new-lead alerts. UNSET MEANS "use the sender
# above" — safe to leave blank, and clearing it is the rollback to one thread.
# Both numbers must sit in the WhatsApp Business Account below, because a
# template is approved for the ACCOUNT, not for an individual number.
WHATSAPP_REMINDER_PHONE_NUMBER_ID=
# The approved template, addressed by NAME (Meta's own addressing; Twilio used
# an opaque Content SID). WhatsApp forbids free text to someone who has not
# messaged us in 24h, and a broker never messages us, so every message must be
# this template. Changing the wording means submitting a new template.
WHATSAPP_TEMPLATE_NAME=
# Its language code. Its own variable because Meta treats (name, language) as
# the identity of a template — the same name in two languages is two templates
# with two approval states, so defaulting this would silently send the wrong one.
WHATSAPP_TEMPLATE_LANGUAGE=en
# The renewal ladder's template (0118) and the callback reminder's (0122) —
# separate templates with their own variables and buttons, nothing about either
# derivable from the lead alert above.
#
# LEAVE UNSET UNTIL META APPROVES THE TEMPLATE. Meta's 132001 ("template does
# not exist") is treated as permanent, so pointing at an unapproved name fails
# every queued row on its FIRST attempt and emails the broker about a WhatsApp
# that never worked. Unset is the safe state: that drain does nothing at all.
WHATSAPP_RENEWAL_TEMPLATE_NAME=
WHATSAPP_RENEWAL_TEMPLATE_LANGUAGE=en
WHATSAPP_CALLBACK_TEMPLATE_NAME=
WHATSAPP_CALLBACK_TEMPLATE_LANGUAGE=en
# App Secret of the WhatsApp app, used to verify delivery webhooks.
# NOT META_APP_SECRET: the WhatsApp app is a DIFFERENT Meta app from the one
# behind the lead pipeline, so that secret cannot verify these payloads — and
# sharing one would mean rotating a secret for one channel broke the other.
WHATSAPP_APP_SECRET=
# A string you invent, entered identically here and in the Meta dashboard's
# "Verify token" box. Meta echoes it once when the Callback URL is saved.
# The callback URL is https://<api host>/webhooks/whatsapp — and saving it in
# Meta only works AFTER that endpoint is deployed, because Meta calls it
# immediately.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# The WhatsApp Business Account that owns the number and the templates.
# Nothing reads this today; it is what a template-listing call would need.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ─── Email fallback for a failed WhatsApp notification (0110) ────────────
#
# THE RULE: every assigned lead reaches its broker through at least one
# channel. WhatsApp is primary; this is what happens when it has definitively
# given up — a permanent error, attempts spent, or a delivery receipt
# reporting 'failed'. Never on a first transient failure.
#
# Unset means no fallback, the same way no Twilio credentials means no
# WhatsApp: the send is skipped, not failed.

# Resend API key (re_...). https://resend.com/api-keys
RESEND_API_KEY=

# The From address. MUST be on a domain verified in Resend — an unverified
# sender is rejected outright, and a lookalike that slips through lands in
# spam, which for this feature is indistinguishable from not sending at all.
# e.g. MyDay CRM <alerts@policyscanner.ca>
RESEND_FROM=

# Public base URL of the CRM frontend, used for the "open this lead" link in
# the fallback email. No trailing slash, e.g. https://myday.policyscanner.ca
#
# Configured rather than derived: the backend has no reliable idea what public
# URL the frontend is served from, and guessing produces a link that 404s on a
# broker's phone at the worst possible moment. Left unset, the email still
# sends and simply omits the link.
CRM_PUBLIC_URL=

# ─── Local development only ──────────────────────────────────────────────
# NEVER SET ANY OF THESE IN PRODUCTION.

# PREVIOUS NAMES for META_GRAPH_API_BASE and META_CAPI_BASE above. Still read,
# so an existing .env keeps working, but the new names win when both are set.
# Prefer the new ones — these two are kept only so a rename cannot silently
# break a local simulator setup that no rename could reach.
GRAPH_API_BASE_OVERRIDE=
META_CAPI_BASE_OVERRIDE=

# A second webhook signing secret, accepted only when set, so the simulator
# can sign payloads without holding the real META_APP_SECRET.
META_APP_SECRET_SIM=
